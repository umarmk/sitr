# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Load it for a single command:   uv run --env-file .env sitr serve
# or for the whole shell:          set -a; source .env; set +a
#
# This is the only secret sitr reads. If it is absent, AI mode is unavailable
# and the interface says so; offline mode never needs it.
OPENROUTER_API_KEY=

# There are no other secrets. The model ID, provider, region and approval for
# AI mode are policy, not secrets: edit destinations[].model in policy.yaml.
